{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:*)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npx vitest *)",
      "Bash(npx prettier *)",
      "Bash(npx tsc *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; echo \"$f\" | grep -qE '\\.(ts|js|json|md|yml|yaml)$' && npx prettier --write \"$f\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
